# ===== Django Core =====
# IMPORTANT: In production, generate a strong, random secret key.
SECRET_KEY=your-super-secret-django-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Database (SQLite for development) =====
DB_NAME=db.sqlite3

# ===== Celery / Redis =====
# Celery broker & result backend both use Redis (default localhost:6379/0).
REDIS_URL=redis://localhost:6379/0

# ===== Email / SMTP =====
# Development: console (prints emails to stdout). For REAL email set the
# backend to smtp and fill in the SMTP server details below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=reminders@yourdomain.com
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True

# ===== Twilio (WhatsApp reminders) =====
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+15551234567
# NOTE: Each User also needs a `phone_number` (E.164 format) for WhatsApp.

# ===== Telegram bot (notifications) =====
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# NOTE: Each User also needs a `telegram_chat_id`.

# Timezone
TIME_ZONE=UTC
